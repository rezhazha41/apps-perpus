# Merge these into upstream .env; this is NOT a complete Supabase configuration.
# Replace school.example with a domain controlled by the school.
SUPABASE_PUBLIC_URL=https://api.perpus.school.example
API_EXTERNAL_URL=https://api.perpus.school.example/auth/v1
# A real auth landing page must be deployed before email confirmation/recovery.
SITE_URL=https://perpus.school.example
# Only add the final app callback after the Android deep link is implemented.
ADDITIONAL_REDIRECT_URLS=id.perpus.perpus-mobile://login-callback,id.perpus.perpus-mobile://reset-password
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
# Keep signup closed while setting up policies and SMTP.
DISABLE_SIGNUP=true
